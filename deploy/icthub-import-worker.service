[Unit]
Description=新疆大学 ICTHub import worker
After=network-online.target icthub-backend.service
Wants=network-online.target icthub-backend.service

[Service]
Type=simple
User=winbeau
Group=winbeau
WorkingDirectory=/home/winbeau/xju-icthub/backend
EnvironmentFile=-/home/winbeau/xju-icthub/backend/.env
ExecStart=/home/winbeau/xju-icthub/backend/target/release/icthub-import-worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/winbeau/xju-icthub/backend/data
ReadWritePaths=/home/winbeau/xju-icthub/backend/uploads
CapabilityBoundingSet=
LockPersonality=true
# Bubblewrap uses NETLINK_ROUTE to configure loopback inside the Codex read-only sandbox.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
