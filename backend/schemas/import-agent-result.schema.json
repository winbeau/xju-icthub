{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "summary",
    "primaryCategory",
    "suggestedTags",
    "owner",
    "source",
    "highestAward",
    "resources",
    "warnings"
  ],
  "properties": {
    "projectName": { "type": "string" },
    "summary": { "type": "string" },
    "primaryCategory": {
      "type": "string",
      "enum": ["传统软件", "智能硬件", "AI 软件", "数字媒体", "研究成果"]
    },
    "suggestedTags": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencedValue" }
    },
    "owner": {
      "anyOf": [{ "$ref": "#/$defs/evidencedValue" }, { "type": "null" }]
    },
    "source": {
      "anyOf": [{ "$ref": "#/$defs/evidencedValue" }, { "type": "null" }]
    },
    "highestAward": {
      "anyOf": [{ "$ref": "#/$defs/evidencedValue" }, { "type": "null" }]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCode", "documents", "presentations", "videos", "links"],
      "properties": {
        "sourceCode": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "presentations": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "videos": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "evidencedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "sourceRef", "evidence", "confidence"],
      "properties": {
        "displayName": { "type": "string" },
        "sourceRef": { "type": "string" },
        "evidence": { "type": "string" },
        "confidence": { "type": "number" }
      }
    }
  }
}
